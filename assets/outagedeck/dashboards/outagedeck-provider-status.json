      {
         "asDropdown": false,
         "icon": "external link",
         "includeVars": false,
         "keepTime": false,
         "tags": [ ],
         "targetBlank": true,
         "title": "OutageDeck provider catalog",
         "tooltip": "Browse all supported providers",
         "type": "link",
         "url": "https://outagedeck.com/providers?utm_source=grafana&utm_medium=dashboard&utm_campaign=prometheus_exporter"
      }
   ],
   "liveNow": false,
   "panels": [
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
         },
         "description": "Normalized provider status: operational, maintenance, degraded, partial outage, major outage, or unknown.",
         "fieldConfig": {
            "defaults": {
               "color": {
                  "mode": "thresholds"
               },
               "mappings": [
                  {
                     "options": {
                        "0": {
                           "color": "dark-gray",
                           "index": 0,
                           "text": "Unknown"
                        },
                        "1": {
                           "color": "green",
                           "index": 1,
                           "text": "Operational"
                        },
                        "2": {
                           "color": "blue",
                           "index": 2,
                           "text": "Maintenance"
                        },
                        "3": {
                           "color": "orange",
                           "index": 3,
                           "text": "Degraded"
                        },
                        "4": {
                           "color": "semi-dark-orange",
                           "index": 4,
                           "text": "Partial outage"
                        },
                        "5": {
                           "color": "red",
                           "index": 5,
                           "text": "Major outage"
                        }
                     },
                     "type": "value"
                  }
               ],
               "noValue": "No data",
               "thresholds": {
                  "mode": "absolute",
                  "steps": [
                     {
                        "color": "dark-gray",
                        "value": null
                     },
                     {
                        "color": "green",
                        "value": 1
                     },
                     {
                        "color": "blue",
                        "value": 2
                     },
                     {
                        "color": "orange",
                        "value": 3
                     },
                     {
                        "color": "semi-dark-orange",
                        "value": 4
                     },
                     {
                        "color": "red",
                        "value": 5
                     }
                  ]
               }
            },
            "overrides": [ ]
         },
         "gridPos": {
            "h": 6,
            "w": 12,
            "x": 0,
            "y": 0
         },
         "id": 1,
         "options": {
            "colorMode": "background",
            "graphMode": "none",
            "justifyMode": "auto",
            "orientation": "horizontal",
            "percentChangeColorMode": "standard",
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ],
               "fields": "",
               "values": false
            },
            "showPercentChange": false,
            "textMode": "auto",
            "wideLayout": true
         },
         "pluginVersion": "11.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${DS_PROMETHEUS}"
               },
               "editorMode": "code",
               "expr": "max by (provider, name) (outagedeck_provider_status_code{provider=~\"$provider\"})",
               "instant": true,
               "legendFormat": "{{name}}",
               "range": false,
               "refId": "A"
            }
         ],
         "title": "Provider health",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
         },
         "description": "Total active incidents across the selected providers.",
         "fieldConfig": {
            "defaults": {
               "color": {
                  "mode": "thresholds"
               },
               "decimals": 0,
               "mappings": [ ],
               "thresholds": {
                  "mode": "absolute",
                  "steps": [
                     {
                        "color": "green",
                        "value": null
                     },
                     {
                        "color": "orange",
                        "value": 1
                     },
                     {
                        "color": "red",
                        "value": 3
                     }
                  ]
               }
            },
            "overrides": [ ]
         },
         "gridPos": {
            "h": 6,
            "w": 4,
            "x": 12,
            "y": 0
         },
         "id": 2,
         "options": {
            "colorMode": "value",
