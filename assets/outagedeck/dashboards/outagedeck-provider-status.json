         "targets": [
            {
               "editorMode": "code",
               "expr": "sum(outagedeck_provider_active_incidents{provider=~\"$provider\"})",
               "instant": true,
               "legendFormat": "Incidents",
               "range": false,
               "refId": "A"
            }
         ],
         "title": "Active incidents",
         "type": "stat"
      },
