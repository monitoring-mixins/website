         "transformations": [
            {
               "id": "organize",
               "options": {
                  "excludeByName": {
                     "Time": true,
                     "__name__": true,
                     "instance": true,
                     "job": true,
                     "service": true
                  },
                  "indexByName": {
                     "Value": 2,
                     "name": 1,
                     "provider": 0
                  },
                  "renameByName": {
                     "Value": "Status",
                     "name": "Service",
                     "provider": "Provider"
